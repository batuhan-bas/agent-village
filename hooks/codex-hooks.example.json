{
  "description": "Agent Village: forwards each hook payload to the desktop app. Background, one-second timeout, silent if the app isn't running.",
  "hooks": {
    "PreToolUse": [{ "hooks": [{ "type": "command", "async": true, "timeout": 2,
      "command": "curl -s -m 1 -o /dev/null -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:4343/event || true",
      "commandWindows": "curl.exe -s -m 1 -o NUL -X POST -H \"Content-Type: application/json\" --data-binary @- http://127.0.0.1:4343/event" }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "async": true, "timeout": 2,
      "command": "curl -s -m 1 -o /dev/null -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:4343/event || true",
      "commandWindows": "curl.exe -s -m 1 -o NUL -X POST -H \"Content-Type: application/json\" --data-binary @- http://127.0.0.1:4343/event" }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "async": true, "timeout": 2,
      "command": "curl -s -m 1 -o /dev/null -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:4343/event || true",
      "commandWindows": "curl.exe -s -m 1 -o NUL -X POST -H \"Content-Type: application/json\" --data-binary @- http://127.0.0.1:4343/event" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "async": true, "timeout": 2,
      "command": "curl -s -m 1 -o /dev/null -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:4343/event || true",
      "commandWindows": "curl.exe -s -m 1 -o NUL -X POST -H \"Content-Type: application/json\" --data-binary @- http://127.0.0.1:4343/event" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "timeout": 2,
      "command": "curl -s -m 1 -o /dev/null -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:4343/event || true",
      "commandWindows": "curl.exe -s -m 1 -o NUL -X POST -H \"Content-Type: application/json\" --data-binary @- http://127.0.0.1:4343/event" }] }]
  }
}
